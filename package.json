{
  "name": "@local/dsh-auv",
  "version": "0.1.0",
  "private": true,
  "description": "DeepSeek Harness plugin that exposes AUV desktop automation (screenshots, OCR, input, windows) as native model tools",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liliumneko/dsh-plugin-auv.git"
  },
  "homepage": "https://github.com/liliumneko/dsh-plugin-auv#readme",
  "bugs": {
    "url": "https://github.com/liliumneko/dsh-plugin-auv/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "auv",
    "computer-use",
    "desktop-automation",
    "macos"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@auv-js/sdk": "0.0.43",
    "es-toolkit": "^1.53.2",
    "tsdown": "^0.23.7"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "check": "node tools/check-tools.mjs",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@11.20.0"
}
